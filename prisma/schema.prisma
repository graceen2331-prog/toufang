  milestoneLabel String? @map("milestone_label")
  milestoneSnapshot Json @default("{}") @map("milestone_snapshot")
  payeeNameSnapshot String? @map("payee_name_snapshot")
  payeeAccountFingerprint String? @map("payee_account_fingerprint")
  payeeAccountFingerprintVersion String? @map("payee_account_fingerprint_version")
  payeeAccountLast4 String? @map("payee_account_last4")
  invoiceNumber String? @map("invoice_number")
  invoiceIssuer String? @map("invoice_issuer")
  invoiceAmountCents Int? @map("invoice_amount_cents")
  invoiceCurrency String? @map("invoice_currency")
  invoiceExceptionReason String? @map("invoice_exception_reason")
  invoiceFingerprint String? @map("invoice_fingerprint")
  dedupeFingerprint String? @map("dedupe_fingerprint")
  approvalCheckpointId String? @unique @map("approval_checkpoint_id")
  approvalSnapshot Json @default("{}") @map("approval_snapshot")
  approvalSnapshotHash String? @map("approval_snapshot_hash")
  approvalHashAlgorithm String? @map("approval_hash_algorithm")
  settlementRequestKey String? @map("settlement_request_key")
  reconciliationReference String? @map("reconciliation_reference")
  reconciliationEvidence Json @default("{}") @map("reconciliation_evidence")
  reconciliationHash String? @map("reconciliation_hash")
  paidAt      DateTime? @map("paid_at")
  paidBy      String?   @map("paid_by")
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([tenantId])
  @@index([contractId])
  @@unique([tenantId, requestKey])
  @@unique([tenantId, settlementRequestKey])
  @@unique([tenantId, reconciliationReference])
  @@index([tenantId, contractId, status])
  @@map("payment_records")
}

