// 横切：统一日粒度指标快照（同实体/平台/日期幂等更新）
model PerformanceMetric {
  id                    String   @id @default(uuid(7))
  tenantId              String   @map("tenant_id")
  entityType            String   @map("entity_type") // campaign | campaign_creator | content_asset
  entityId              String   @map("entity_id")
  platform              String?
  metricDate            DateTime @map("metric_date") @db.Date
  metrics               Json // 缺失 key 表示未提供；数值 0 表示明确观测为 0
  source                String   @default("manual") // manual | import | integration
  currency              String?
  attributionWindowDays Int?     @map("attribution_window_days")
  attributionModel      String?  @map("attribution_model")
  sourceRecordId        String?  @map("source_record_id")
  sourceObservedAt      DateTime? @map("source_observed_at")
  ingestedAt            DateTime @default(now()) @updatedAt @map("ingested_at")
  metricSchemaVersion   Int      @default(1) @map("metric_schema_version")
  createdAt             DateTime @default(now()) @map("created_at")
  createdBy             String?  @map("created_by")

  @@unique([tenantId, entityType, entityId, platform, metricDate])
  @@index([tenantId])
  @@index([entityType, entityId, metricDate])
  @@map("performance_metrics")
}

model Insight {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  campaignId    String?   @map("campaign_id")
  kind          String // anomaly | opportunity | risk | summary
  title         String
  content       String
  severity      String    @default("info") // info | warning | critical
  data          Json      @default("{}")
  status        String    @default("open") // open | acknowledged | dismissed
  // AI 溯源
  aiGenerated   Boolean   @default(true) @map("ai_generated")
  agentRunId    String?   @map("agent_run_id")
  promptKey     String?   @map("prompt_key")
  promptVersion String?   @map("prompt_version")
  model         String?
  confidence    Float?
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([campaignId])
  @@map("insights")
}

model Report {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  seriesId      String    @map("series_id")
  version       Int       @default(1)
  supersedesId  String?   @unique @map("supersedes_id")
  lockVersion   Int       @default(0) @map("lock_version")
  campaignId    String?   @map("campaign_id")
  title         String
  kind          String    @default("campaign_retro") // campaign_retro | executive | custom
  status        String    @default("draft") // generating | draft | in_review | approved | exported
  content       Json      @default("{}") // 结构化报告块
  approvedAt    DateTime? @map("approved_at")
  approvedBy    String?   @map("approved_by")
  submittedSnapshotHash String? @map("submitted_snapshot_hash")
  approvedSnapshotHash  String? @map("approved_snapshot_hash")
  hashAlgorithm String?  @map("hash_algorithm")
  derivationReason String? @map("derivation_reason")
  // AI 溯源
  aiGenerated   Boolean   @default(true) @map("ai_generated")
  agentRunId    String?   @map("agent_run_id")
  promptKey     String?   @map("prompt_key")
  promptVersion String?   @map("prompt_version")
  model         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")

  supersedes   Report?       @relation("ReportRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Report?       @relation("ReportRevision")
  exports      ReportExport[]

  @@unique([tenantId, seriesId, version])
  @@index([tenantId])
  @@index([campaignId])
  @@map("reports")
}

model ReportExport {
  id             String   @id @default(uuid(7))
  tenantId       String   @map("tenant_id")
  reportId       String   @map("report_id")
  reportVersion  Int      @map("report_version")
  format         String   @default("json_snapshot")
  recipient      String
  purpose        String?
  snapshot       Json
  snapshotHash   String   @map("snapshot_hash")
  hashAlgorithm  String   @map("hash_algorithm")
  idempotencyKey String   @map("idempotency_key")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, reportId, createdAt])
  @@map("report_exports")
}

