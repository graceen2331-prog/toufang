// 9. AI 与工作流（5，全部 append-only 不软删）
// ============================================================

model WorkflowRun {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workflowKey   String    @map("workflow_key") // strategy | research | creator_discovery | creator_scoring | outreach | negotiation | content_review | analytics | knowledge_learning
  status        String    @default("queued") // queued | running | waiting_for_human | retrying | completed | failed | cancelled
  subjectType   String?   @map("subject_type") // campaign | campaign_creator | content_asset | ...
  subjectId     String?   @map("subject_id")
  input         Json      @default("{}")
  output        Json      @default("{}")
  failureReason String?   @map("failure_reason")
  retryOfRunId  String?   @unique @map("retry_of_run_id")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")

  steps       WorkflowStep[]
  agentRuns   AgentRun[]
  checkpoints HumanCheckpoint[]
  retryOf     WorkflowRun?  @relation("WorkflowRunRetry", fields: [retryOfRunId], references: [id], onDelete: Restrict)
  retriedBy   WorkflowRun?  @relation("WorkflowRunRetry")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([subjectType, subjectId])
  @@map("workflow_runs")
}

model WorkflowStep {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  runId         String    @map("run_id")
  stepKey       String    @map("step_key")
  stepOrder     Int       @map("step_order")
  status        String    @default("pending") // pending | running | waiting_for_human | completed | failed | skipped
  attempt       Int       @default(0)
  input         Json      @default("{}")
  output        Json      @default("{}")
  failureReason String?   @map("failure_reason")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  run WorkflowRun @relation(fields: [runId], references: [id])

  @@unique([runId, stepKey])
  @@index([tenantId])
  @@map("workflow_steps")
}

model AgentRun {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workflowRunId String?   @map("workflow_run_id")
  agentKey      String    @map("agent_key") // research | creator_discovery | ... 见 ai/agents
  status        String    @default("running") // running | completed | failed
  input         Json      @default("{}")
  output        Json      @default("{}")
  toolCalls     Json      @default("[]") @map("tool_calls")
  promptKey     String?   @map("prompt_key")
  promptVersion String?   @map("prompt_version")
  model         String?
  failureReason String?   @map("failure_reason")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")

  workflowRun WorkflowRun? @relation(fields: [workflowRunId], references: [id])

  @@index([tenantId])
  @@index([workflowRunId])
  @@index([tenantId, agentKey, createdAt])
  @@map("agent_runs")
}

// 横切：统一人工审批（审批中心数据源）
model HumanCheckpoint {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workflowRunId String?   @map("workflow_run_id")
  type          String // strategy | shortlist | brief | outreach_send | negotiation_terms | content | contract | payment | report | budget
  status        String    @default("pending") // pending | approved | rejected | changes_requested | escalated
  title         String
  summary       String?
  entityType    String?   @map("entity_type")
  entityId      String?   @map("entity_id")
  payload       Json      @default("{}") // 审批上下文（diff、金额、风险提示）
  priority      String    @default("normal") // low | normal | high | urgent
  assigneeRole  String?   @map("assignee_role") // 需要哪个角色审批
  assigneeId    String?   @map("assignee_id") // 指定审批人；为空时进入角色审批池
  dueAt         DateTime? @map("due_at")
  escalationLevel Int     @default(0) @map("escalation_level")
  lastEscalatedAt DateTime? @map("last_escalated_at")
  lastEscalatedBy String? @map("last_escalated_by")
  version       Int       @default(0)
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  decisionReason String?  @map("decision_reason")
  decisionMetadata Json   @default("{}") @map("decision_metadata")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workflowRun WorkflowRun? @relation(fields: [workflowRunId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, assigneeId, dueAt])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, createdBy, status])
  @@index([entityType, entityId])
  @@map("human_checkpoints")
}

// 审批操作追加事件：转交、升级、决策均在同一事务内写入，便于审计与追责
model HumanCheckpointEvent {
  id              String    @id @default(uuid(7))
  tenantId        String    @map("tenant_id")
  checkpointId    String    @map("checkpoint_id")
  eventType       String    @map("event_type") // created | assigned | reassigned | escalated | decided
  actorId         String?   @map("actor_id")
  fromStatus      String?   @map("from_status")
  toStatus        String?   @map("to_status")
  fromAssigneeId  String?   @map("from_assignee_id")
  toAssigneeId    String?   @map("to_assignee_id")
  reason          String?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, checkpointId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@map("human_checkpoint_events")
}

// 每次模型调用一行（token/成本记账）
model AiUsageEvent {
  id               String   @id @default(uuid(7))
  tenantId         String   @map("tenant_id")
  agentRunId       String?  @map("agent_run_id")
  agentKey         String?  @map("agent_key")
  provider         String // openai | fake | anthropic | gemini
