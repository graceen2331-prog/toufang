model PaymentRecord {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  contractId  String    @map("contract_id")
  status      String    @default("not_started") // 8 态状态机
  version     Int       @default(0)
  amountCents Int       @map("amount_cents")
