  requestId  String?  @map("request_id")
  actorType  String   @default("user") @map("actor_type") // user | system | agent
  actorId    String?  @map("actor_id")
  action     String // brand.create | campaign.status_change | auth.login | ...
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  type       String // approval_pending | workflow_completed | workflow_failed | risk_alert | mention | system
  title      String
  body       String?
  linkUrl    String?   @map("link_url")
  priority   String    @default("normal")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

model IntegrationConnection {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  provider   String // email_smtp | tiktok | instagram | youtube | ...
  status     String    @default("not_connected") // not_connected | connected | needs_reauth | error
  config     Json      @default("{}") // 非敏感配置
  secrets    Json      @default("{}") // 应用层加密
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integration_connections")
}
