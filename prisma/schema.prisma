// KOL Marketing OS — 数据库 Schema
// 约定：
// - 所有业务表带 tenantId（组织级隔离），repository 层强制注入过滤
// - 软删除：deletedAt/deletedBy；append-only 表（audit/workflow/usage/metrics/events）不软删
// - 审计字段：createdBy/updatedBy（用户 id，系统操作为 null）
// - AI 溯源字段：aiGenerated/agentRunId/promptKey/promptVersion/model/confidence
// - 状态字段用 String，状态机定义与转移校验在 src/shared/constants/status.ts

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================================
// 1. 租户与身份（7）
// ============================================================

model Organization {
  id                 String    @id @default(uuid(7))
  name               String
  slug               String    @unique
  status             String    @default("active") // active | trialing | suspended | cancelled
  aiMonthlyBudgetCents Int     @default(100000) @map("ai_monthly_budget_cents")
  settings           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  workspaces  Workspace[]
  memberships Membership[]
  roles       Role[]

  @@map("organizations")
}

model Workspace {
  id        String    @id @default(uuid(7))
  tenantId  String    @map("tenant_id")
  name      String
  slug      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("workspaces")
}

model User {
  id           String    @id @default(uuid(7))
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  status       String    @default("active") // invited | active | disabled | locked
  avatarUrl    String?   @map("avatar_url")
  locale       String    @default("zh-CN")
  settings     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  workspaceId String?   @map("workspace_id")
  brandScope  Json      @default("[]") @map("brand_scope") // 品牌级数据范围，空数组=全部
  status      String    @default("active") // invited | active | disabled
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization @relation(fields: [tenantId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  key         String // admin | director | manager | kol_manager | content_manager | finance | viewer | 自定义
  name        String
  permissions Json      @default("[]") // 权限字符串数组，常量表在 shared/constants/permissions.ts
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization @relation(fields: [tenantId], references: [id])
  memberships  Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Session {
  id          String   @id @default(uuid(7))
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  activeOrgId String?  @map("active_org_id")
  expiresAt   DateTime @map("expires_at")
  ip          String?
  userAgent   String?  @map("user_agent")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model ApiToken {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     Json      @default("[]")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  deletedAt  DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("api_tokens")
}

// ============================================================
// 2. 品牌与产品（2）
// ============================================================

model Brand {
  id              String    @id @default(uuid(7))
  tenantId        String    @map("tenant_id")
  name            String
  slug            String
  description     String?
  industry        String?
  markets         Json      @default("[]") // 目标市场列表
  guidelines      Json      @default("{}") // 品牌规范：语气/视觉/表达要求
  restrictedTerms Json      @default("[]") @map("restricted_terms") // 禁用词
  logoFileId      String?   @map("logo_file_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  products  Product[]
  campaigns Campaign[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

model Product {
  id               String    @id @default(uuid(7))
  tenantId         String    @map("tenant_id")
  brandId          String    @map("brand_id")
  name             String
  description      String?
  category         String?
  price            Json      @default("{}") // {amount, currency}
  keyClaims        Json      @default("[]") @map("key_claims") // 核心卖点
  restrictedClaims Json      @default("[]") @map("restricted_claims") // 禁止声明
  links            Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([tenantId])
  @@index([brandId])
  @@map("products")
}

// ============================================================
// 3. 达人（6）
// ============================================================

model Creator {
  id                 String    @id @default(uuid(7))
  tenantId           String    @map("tenant_id")
  displayName        String    @map("display_name")
  bio                String?
  profileSummary     String?   @map("profile_summary") // AI 生成画像摘要
  relationshipStatus String    @default("new") @map("relationship_status") // 状态机见 shared/constants
  riskLevel          String    @default("unknown") @map("risk_level") // unknown | low | medium | high
  country            String?
  languages          Json      @default("[]")
  categories         Json      @default("[]") // 内容主题分类
  tags               String[]  @default([])
  contactInfo        Json      @default("{}") @map("contact_info") // 应用层 AES 加密存储
  source             String    @default("manual") // manual | import | discovery
  // AI 溯源
  aiGenerated        Boolean   @default(false) @map("ai_generated")
  agentRunId         String?   @map("agent_run_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")

  platformAccounts CreatorPlatformAccount[]
  metricSnapshots  CreatorMetricSnapshot[]
  contentSamples   CreatorContentSample[]
  scores           CreatorScore[]
  notes            CreatorNote[]
  campaignCreators CampaignCreator[]

  @@index([tenantId])
  @@index([tenantId, relationshipStatus])
  @@map("creators")
}

model CreatorPlatformAccount {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  creatorId      String    @map("creator_id")
  platform       String // tiktok | instagram | youtube | xiaohongshu | douyin | bilibili | weibo
  handle         String
  url            String?
  followers      Int       @default(0)
  engagementRate Float     @default(0) @map("engagement_rate")
  avgViews       Int       @default(0) @map("avg_views")
  metrics        Json      @default("{}") // 平台特有指标
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  creator Creator @relation(fields: [creatorId], references: [id])

  @@unique([tenantId, platform, handle])
  @@index([tenantId])
  @@index([creatorId])
  @@map("creator_platform_accounts")
}

// append-only 快照（受众画像 + 表现指标合并为 payload）
model CreatorMetricSnapshot {
  id         String   @id @default(uuid(7))
  tenantId   String   @map("tenant_id")
  creatorId  String   @map("creator_id")
  platform   String?
  kind       String // audience | performance
  payload    Json
  capturedAt DateTime @default(now()) @map("captured_at")
  source     String   @default("manual")
  createdAt  DateTime @default(now()) @map("created_at")

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([tenantId])
  @@index([creatorId, capturedAt])
  @@map("creator_metric_snapshots")
}

model CreatorContentSample {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  creatorId   String    @map("creator_id")
  platform    String?
  url         String?
  title       String?
  contentType String?   @map("content_type") // video | image | article | live
  metrics     Json      @default("{}")
  analysis    Json      @default("{}") // AI 内容分析
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([tenantId])
  @@index([creatorId])
  @@map("creator_content_samples")
}

model CreatorScore {
  id            String   @id @default(uuid(7))
  tenantId      String   @map("tenant_id")
  creatorId     String   @map("creator_id")
  campaignId    String?  @map("campaign_id") // null = 通用评分
  overallScore  Float    @map("overall_score")
  tier          String? // S | A | B | C
  dimensions    Json     @default("{}") // {brand_fit, audience_fit, content_fit, engagement, cost_efficiency, estimated_roi}
  risk          Json     @default("{}") // {level, flags: [...]}
  explanation   String?
  // AI 溯源
  aiGenerated   Boolean  @default(true) @map("ai_generated")
  agentRunId    String?  @map("agent_run_id")
  promptKey     String?  @map("prompt_key")
  promptVersion String?  @map("prompt_version")
  model         String?
  confidence    Float?
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([tenantId])
  @@index([creatorId])
  @@index([campaignId])
  @@map("creator_scores")
}

model CreatorNote {
  id        String    @id @default(uuid(7))
  tenantId  String    @map("tenant_id")
  creatorId String    @map("creator_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  deletedAt DateTime? @map("deleted_at")

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([tenantId])
  @@index([creatorId])
  @@map("creator_notes")
}

// ============================================================
// 4. Campaign（6，含横切 status_events）
// ============================================================

model Campaign {
  id           String    @id @default(uuid(7))
  tenantId     String    @map("tenant_id")
  brandId      String    @map("brand_id")
  productId    String?   @map("product_id")
  name         String
  objective    String? // awareness | conversion | launch | ...
  status       String    @default("draft") // 17 态状态机见 shared/constants
  healthStatus String    @default("on_track") @map("health_status") // on_track | at_risk | blocked | completed
  markets      Json      @default("[]")
  platforms    Json      @default("[]")
  budgetTotalCents Int   @default(0) @map("budget_total_cents")
  currency     String    @default("CNY")
  goals        Json      @default("{}") // KPI 目标
  milestones   Json      @default("[]") // 时间线里程碑
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  ownerId      String?   @map("owner_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  brand            Brand                     @relation(fields: [brandId], references: [id])
  campaignCreators CampaignCreator[]
  strategyVersions CampaignStrategyVersion[]
  tasks            CampaignTask[]
  budgetItems      CampaignBudgetItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([brandId])
  @@map("campaigns")
}

// 核心中间表：达人在 Campaign 中的执行状态
model CampaignCreator {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  campaignId     String    @map("campaign_id")
  creatorId      String    @map("creator_id")
  status         String    @default("candidate") // 16 态状态机
  contractStatus String    @default("none") @map("contract_status")
  paymentStatus  String    @default("none") @map("payment_status")
  contentStatus  String    @default("none") @map("content_status")
  role           String? // 建议达人角色：hero | amplifier | seeder
  quotedPriceCents Int?    @map("quoted_price_cents")
  agreedPriceCents Int?    @map("agreed_price_cents")
  currency       String    @default("CNY")
  deliverables   Json      @default("[]")
  // AI 溯源（发现/推荐来源）
  aiGenerated    Boolean   @default(false) @map("ai_generated")
  agentRunId     String?   @map("agent_run_id")
  matchScore     Float?    @map("match_score")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  creator  Creator  @relation(fields: [creatorId], references: [id])

  @@unique([tenantId, campaignId, creatorId])
  @@index([tenantId])
  @@index([campaignId, status])
  @@index([creatorId])
  @@map("campaign_creators")
}

model CampaignStrategyVersion {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  campaignId    String    @map("campaign_id")
  version       Int
  status        String    @default("draft") // draft | in_review | approved | rejected | locked
  content       Json // 策略结构：目标/平台组合/达人组合/预算分配/KPI/风险
  summary       String?
  // AI 溯源
  aiGenerated   Boolean   @default(true) @map("ai_generated")
  agentRunId    String?   @map("agent_run_id")
  promptKey     String?   @map("prompt_key")
  promptVersion String?   @map("prompt_version")
  model         String?
  confidence    Float?
  approvedAt    DateTime? @map("approved_at")
  approvedBy    String?   @map("approved_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  deletedAt     DateTime? @map("deleted_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([tenantId, campaignId, version])
  @@index([tenantId])
  @@map("campaign_strategy_versions")
}

model CampaignTask {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  campaignId String    @map("campaign_id")
  title      String
  description String?
  status     String    @default("todo") // todo | in_progress | done | cancelled
  priority   String    @default("normal") // low | normal | high | urgent
  assigneeId String?   @map("assignee_id")
  dueAt      DateTime? @map("due_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([tenantId])
  @@index([campaignId, status])
  @@map("campaign_tasks")
}

model CampaignBudgetItem {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  campaignId  String    @map("campaign_id")
  category    String // creator_fee | production | media | other
  name        String
  plannedCents Int      @default(0) @map("planned_cents")
  reservedCents Int     @default(0) @map("reserved_cents")
  spentCents  Int       @default(0) @map("spent_cents")
  currency    String    @default("CNY")
  relatedType String?   @map("related_type") // campaign_creator | contract | ...
  relatedId   String?   @map("related_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([tenantId])
  @@index([campaignId])
  @@map("campaign_budget_items")
}

// 横切：通用状态历史（append-only，替代各实体独立的状态流水表）
model StatusEvent {
  id         String   @id @default(uuid(7))
  tenantId   String   @map("tenant_id")
  entityType String   @map("entity_type") // campaign | campaign_creator | outreach_message | content_asset | contract | ...
  entityId   String   @map("entity_id")
  field      String   @default("status") // 支持子状态：status | contract_status | payment_status | content_status
  fromValue  String?  @map("from_value")
  toValue    String   @map("to_value")
  actorType  String   @default("user") @map("actor_type") // user | system | agent
  actorId    String?  @map("actor_id")
  reason     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([entityType, entityId, createdAt])
  @@map("status_events")
}

// ============================================================
// 5. 外联与谈判（4）
// ============================================================

model OutreachThread {
  id                 String    @id @default(uuid(7))
  tenantId           String    @map("tenant_id")
  campaignCreatorId  String    @map("campaign_creator_id")
  channel            String    @default("email") // email | dm_manual
  status             String    @default("open") // open | replied | negotiating | closed_won | closed_lost | no_response
  subject            String?
  lastMessageAt      DateTime? @map("last_message_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")
  deletedAt          DateTime? @map("deleted_at")

  messages           OutreachMessage[]
  negotiationRecords NegotiationRecord[]

  @@index([tenantId])
  @@index([campaignCreatorId])
  @@map("outreach_threads")
}

model OutreachMessage {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  threadId       String    @map("thread_id")
  sequenceId     String?   @map("sequence_id")
  direction      String    @default("outbound") // outbound | inbound
  status         String    @default("draft") // 10 态状态机
  approvalStatus String    @default("not_required") @map("approval_status") // not_required | pending | approved | rejected
  subject        String?
  body           String
  replyIntent    String?   @map("reply_intent") // interested | reject | negotiate | need_info | irrelevant（inbound 分类）
  // AI 溯源
  aiGenerated    Boolean   @default(false) @map("ai_generated")
  agentRunId     String?   @map("agent_run_id")
  promptKey      String?   @map("prompt_key")
  promptVersion  String?   @map("prompt_version")
  model          String?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")

  thread OutreachThread @relation(fields: [threadId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@index([tenantId, status])
  @@map("outreach_messages")
}

model OutreachSequence {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  campaignId String?   @map("campaign_id")
  name       String
  steps      Json      @default("[]") // [{day_offset, template_hint, channel}]
  status     String    @default("active") // active | paused | archived
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  deletedAt  DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("outreach_sequences")
}

model NegotiationRecord {
  id              String    @id @default(uuid(7))
  tenantId        String    @map("tenant_id")
  threadId        String    @map("thread_id")
  status          String    @default("analyzing") // analyzing | negotiating | approval_required | agreed | closed
  quotedPriceCents Int?     @map("quoted_price_cents")
  counterPriceCents Int?    @map("counter_price_cents")
  agreedPriceCents Int?     @map("agreed_price_cents")
  currency        String    @default("CNY")
  pricingAnalysis Json      @default("{}") @map("pricing_analysis") // AI 报价分析
  strategy        Json      @default("{}") // AI 谈判策略建议
  agreedTerms     Json      @default("{}") @map("agreed_terms") // 交付物/授权/付款条款
  // AI 溯源
  agentRunId      String?   @map("agent_run_id")
  promptKey       String?   @map("prompt_key")
  promptVersion   String?   @map("prompt_version")
  model           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")

  thread OutreachThread @relation(fields: [threadId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("negotiation_records")
}

// ============================================================
// 6. Brief 与内容（4）
// ============================================================

model Brief {
  id               String    @id @default(uuid(7))
  tenantId         String    @map("tenant_id")
  campaignId       String    @map("campaign_id")
  title            String
  status           String    @default("draft") // draft | in_review | approved | locked | archived
  currentVersionId String?   @map("current_version_id")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")

  versions BriefVersion[]

  @@index([tenantId])
  @@index([campaignId])
  @@map("briefs")
}

model BriefVersion {
  id            String   @id @default(uuid(7))
  tenantId      String   @map("tenant_id")
  briefId       String   @map("brief_id")
  version       Int
  content       Json // 结构化 Brief：背景/卖点/必须表达/禁止表达/CTA/交付物/时间线/平台要求
  plainText     String   @map("plain_text") // 用于全文检索与 diff
  changeSummary String?  @map("change_summary")
  // AI 溯源
  aiGenerated   Boolean  @default(false) @map("ai_generated")
  agentRunId    String?  @map("agent_run_id")
  promptKey     String?  @map("prompt_key")
  promptVersion String?  @map("prompt_version")
  model         String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  brief Brief @relation(fields: [briefId], references: [id])

  @@unique([tenantId, briefId, version])
  @@index([tenantId])
  @@map("brief_versions")
}

model ContentAsset {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  campaignCreatorId String    @map("campaign_creator_id")
  briefId           String?   @map("brief_id")
  title             String?
  status            String    @default("submitted") // 9 态状态机
  contentType       String?   @map("content_type") // video | image | article | live
  platform          String?
  caption           String?
  transcript        String?
  url               String?
  fileId            String?   @map("file_id")
  plannedPublishAt  DateTime? @map("planned_publish_at")
  publishedAt       DateTime? @map("published_at")
  publishedUrl      String?   @map("published_url")
  activeReviewId    String?   @map("active_review_id")
  approvedReviewId  String?   @map("approved_review_id")
  approvedCheckpointId String? @map("approved_checkpoint_id")
  approvedContentHash String?  @map("approved_content_hash")
  contentApprovedAt DateTime?  @map("content_approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")

  reviews ContentReview[]

  @@index([tenantId])
  @@index([campaignCreatorId])
  @@index([tenantId, status])
  @@index([tenantId, activeReviewId])
  @@map("content_assets")
}

model ContentReview {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  contentAssetId String    @map("content_asset_id")
  status         String    @default("queued") // queued | reviewing | completed
  decision       String? // approved | needs_revision | rejected
  riskLevel      String?   @map("risk_level") // low | medium | high
  findings       Json      @default("[]") // [{type, severity, quote, issue, suggestion}]
  feedback       String? // 面向达人的修改意见
  reviewerId     String?   @map("reviewer_id") // 人工审核人
  inputHash      String?   @map("input_hash")
  ruleSetVersion String?   @map("rule_set_version")
  deterministicSummary Json @default("{}") @map("deterministic_summary")
  normalizationNotes Json @default("[]") @map("normalization_notes")
  finalDecision  String?   @map("final_decision") // approved | changes_requested | rejected
  checkpointId   String?   @unique @map("checkpoint_id")
  overrideMetadata Json    @default("{}") @map("override_metadata")
  // AI 溯源
  aiGenerated    Boolean   @default(false) @map("ai_generated")
  agentRunId     String?   @map("agent_run_id")
  promptKey      String?   @map("prompt_key")
  promptVersion  String?   @map("prompt_version")
  model          String?
  confidence     Float?
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")

  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id])

  @@index([tenantId])
  @@index([contentAssetId])
  @@map("content_reviews")
}

