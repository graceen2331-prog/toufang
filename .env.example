# ===== 数据库 =====
DATABASE_URL="postgresql://toufang:toufang@localhost:5432/toufang"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== 应用与安全（以下 dev 值仅供本地，生产必须全部替换） =====
APP_ORIGIN="http://localhost:3000"
# 生产环境填写由可信反向代理覆盖的单值 IP 头，例如 x-real-ip；本地留空会关闭 IP 维度
AUTH_CLIENT_IP_HEADER=""
AUTH_RATE_LIMIT_BACKEND="memory"
AUTH_RATE_LIMIT_HMAC_KEY="dev-auth-rate-limit-key-change-me"
SESSION_ABSOLUTE_TTL_HOURS="12"
SESSION_IDLE_TTL_HOURS="2"
# 敏感字段（达人联系方式等）AES 加密密钥：openssl rand -base64 32
DATA_ENCRYPTION_KEY="dev-encryption-key-change-me"
PAYMENT_FINGERPRINT_KEY="dev-payment-fingerprint-key-change-me"

# ===== AI 兼容回退 =====
# 模型配置请优先在「Admin → AI 设置」页面填写；下列变量仅用于本地/CI 回退。
# 可选：openai | fake（测试/CI 用确定性假数据，不消耗 token）
MODEL_PROVIDER="fake"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# 可选覆盖默认模型
OPENAI_CHAT_MODEL="gpt-4.1"
OPENAI_CHAT_MODEL_LIGHT="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ===== 文件存储 =====
# local = 存到 ./storage 目录（开发）；将来可扩展 s3
FILE_STORAGE="local"

# ===== 应用 =====
NEXT_PUBLIC_APP_NAME="KOL Marketing OS"
